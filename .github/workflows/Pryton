    koord = geocode_kota(data["kota"])
    if koord:
        print(f"\nWilayah registrasi (bukan alamat): {koord['label']}")
        print(f"Peta: {koord['osm']}")

    p1 = tulis_laporan_iasc(data, meta)
    p2 = tulis_surat_pjp(data, meta, penyidik)
    p3 = tulis_checklist()

    print(f"\n[+] Laporan IASC       : {p1}")
    print(f"[+] Surat ke PJP/bank  : {p2}")
    print(f"[+] Checklist bukti    : {p3}")

    return data


