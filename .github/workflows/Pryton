# 3. GENERATOR LAPORAN IASC
# ============================================================

TEMPLATE_IASC = """LAPORAN DUGAAN PENIPUAN BERBASIS QRIS
Dibuat: {waktu}

A. PELAPOR
   Nama      : {pelapor_nama}
   No. HP    : {pelapor_hp}
   Email     : {pelapor_email}

B. TRANSAKSI
   Tanggal   : {tgl}
   Nominal   : Rp {nominal}
   Bukti     : {bukti}

C. DATA MERCHANT (dari payload QRIS)
   Nama      : {nama_merchant}
   NMID      : {nmid}
   Kota      : {kota}
   Kode Pos  : {kode_pos}
   Kriteria  : {kriteria}
   Acquirer  : {acquirer}
   CRC valid : {crc}

   Catatan: kota di atas adalah kota registrasi merchant pada
   payload QRIS. Alamat fisik hanya dapat dibuka oleh PJP/bank
   melalui permintaan resmi aparat penegak hukum.

D. INDIKASI KEANEHAN
{indikasi}

E. PAYLOAD MENTAH
{payload}

F. PERMINTAAN
   1. Pemblokiran rekening tujuan atas dugaan penipuan.
   2. Penelusuran identitas pemilik merchant via NMID.
   3. Tindak lanjut hukum.

Hormat saya,
{pelapor_nama}
"""


def susun_indikasi(data: dict) -> str:
    poin = []
    if not data["nmid"]:
        poin.append("- NMID tidak ada pada payload.")
    if not data["crc_valid"]:
        poin.append("- CRC tidak valid, payload kemungkinan dimodifikasi.")
    if not data["acquirer"]:
        poin.append("- Acquirer tidak teridentifikasi.")
    if not data["nama_merchant"]:
        poin.append("- Nama merchant kosong.")
    for v in data["validasi"]:
        if v["severity"].lower() in ("error", "warning"):
            poin.append(f"- [{v['severity']}] {v['code']}: {v['pesan']}")
    if not poin:
        poin.append("- Struktur QRIS formal valid. Indikasi penipuan berasal dari "
                     "ketidaksesuaian identitas pelaku dengan nama merchant.")
    return "\n".join(poin)


def tulis_laporan_iasc(data: dict, meta: dict) -> str:
    acquirer_str = ", ".join(
        f"{a['nama']} ({a['kode'] or '-'})" for a in data["acquirer"]
    ) or "Tidak teridentifikasi"

    isi = TEMPLATE_IASC.format(
        waktu=datetime.now().strftime("%Y-%m-%d %H:%M:%S"),
        pelapor_nama=meta.get("nama", "-"),
        pelapor_hp=meta.get("hp", "-"),
        pelapor_email=meta.get("email", "-"),
        tgl=meta.get("tgl", "-"),
        nominal=f"{meta.get('nominal', 0):,}".replace(",", "."),
        bukti=meta.get("bukti", "-"),
        nama_merchant=data["nama_merchant"] or "-",
        nmid=data["nmid"] or "-",
        kota=data["kota"] or "-",
        kode_pos=data["kode_pos"] or "-",
        kriteria=data["kriteria"] or "-",
        acquirer=acquirer_str,
        crc="Ya" if data["crc_valid"] else "TIDAK",
        indikasi=susun_indikasi(data),
        payload=data["payload"],
    )

    path = os.path.join(OUTPUT_DIR, "laporan_iasc.txt")
    with open(path, "w", encoding="utf-8") as f:
        f.write(isi)
    return path


