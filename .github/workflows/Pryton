def tulis_surat_pjp(data: dict, meta: dict, penyidik: dict) -> str:
    if not data["acquirer"]:
        raise ValueError("Acquirer tidak teridentifikasi, surat tidak bisa ditujukan.")

    acquirer_str = ", ".join(
        f"{a['nama']} ({a['kode'] or '-'})" for a in data["acquirer"]
    )
    acquirer_utama = data["acquirer"][0]["nama"]

    isi = TEMPLATE_SURAT_PJP.format(
        aquirer_utama=acquirer_utama,
        no_laporan=meta.get("no_laporan", "-"),
        tgl_laporan=meta.get("tgl_laporan", datetime.now().strftime("%Y-%m-%d")),
        instansi=penyidik.get("instansi", "-"),
        pelapor_nama=meta.get("nama", "-"),
        pelapor_hp=meta.get("hp", "-"),
        nama_merchant=data["nama_merchant"] or "-",
        nmid=data["nmid"] or "-",
        kota=data["kota"] or "-",
        acquirer=acquirer_str,
        payload=data["payload"],
        tgl=meta.get("tgl", "-"),
        nominal=f"{meta.get('nominal', 0):,}".replace(",", "."),
        bukti=meta.get("bukti", "-"),
        nama_penyidik=penyidik.get("nama", "-"),
        nip=penyidik.get("nip", "-"),
    )

    path = os.path.join(OUTPUT_DIR, f"surat_permintaan_{acquirer_utama.replace(' ', '_')}.txt")
    with open(path, "w", encoding="utf-8") as f:
        f.write(isi)
    return path


