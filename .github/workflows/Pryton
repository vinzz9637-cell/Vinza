def jalankan(gambar=None, payload_manual=None):
    os.makedirs(OUTPUT_DIR, exist_ok=True)

    meta = {
        "nama": "Nama Lengkap Kamu",
        "hp": "08xxxxxxxxxx",
        "email": "email@kamu.com",
        "tgl": "2026-11-12",
        "nominal": 500000,
        "bukti": "bukti_transfer.jpg",
        "no_laporan": "IASC-XXXXXXXX",
        "tgl_laporan": datetime.now().strftime("%Y-%m-%d"),
    }

    penyidik = {
        "instansi": "Patroli Siber - Polda X",
        "nama": "Nama Penyidik",
        "nip": "NIP. XXXXXXXXX",
    }

    payload = payload_manual or payload_dari_gambar(gambar)
    data = ekstrak_qris(payload)

    print("=" * 55)
    print("DATA MERCHANT")
    print("=" * 55)
    print(f"Nama    : {data['nama_merchant']}")
    print(f"NMID    : {data['nmid']}")
    print(f"Kota    : {data['kota']}")
    print(f"Acquirer: {data['acquirer']}")
    print(f"CRC     : {'valid' if data['crc_valid'] else 'TIDAK VALID'}")
