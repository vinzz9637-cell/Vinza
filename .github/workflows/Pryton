import json
import os
from datetime import datetime

import qriskit
import requests
from pyzxing import BarCodeReader

OUTPUT_DIR = "laporan_qris"


# ============================================================
# 1. EKSTRAKSI
# ============================================================

def payload_dari_gambar(path_gambar: str) -> str:
    reader = BarCodeReader()
    hasil = reader.decode(path_gambar)
    if not hasil:
        raise ValueError("QR tidak terbaca. Scan manual, tempel payload-nya.")
    item = hasil[0]
    return item.get("parsedText") or item.get("rawBytes")


def ekstrak_qris(payload: str) -> dict:
    q = qriskit.parse(payload)

    acquirers = []
    for acc in (q.merchant_accounts or []):
        if acc.acquirer:
            acquirers.append({
                "nama": acc.acquirer.name,
                "kode": getattr(acc.acquirer, "code", None),
            })

    validasi = []
    for v in qriskit.validate(payload):
        validasi.append({
            "severity": v.severity,
            "code": v.code,
            "pesan": v.message,
        })

    return {
        "payload": payload,
        "nama_merchant": q.merchant_name,
        "nmid": q.nmid,
        "kota": getattr(q, "city", None),
        "kode_pos": getattr(q, "postal_code", None),
        "kriteria": getattr(q, "merchant_criteria", None),
        "acquirer": acquirers,
        "validasi": validasi,
        "crc_valid": not any(v["code"] == "CRC" for v in validasi),
    }


# ============================================================
# 2. GEOCODE WILAYAH (KOTA REGISTRASI, BUKAN ALAMAT)
# ============================================================

def geocode_kota(kota: str) -> dict | None:
    if not kota:
        return None
    try:
        r = requests.get(
            "https://nominatim.openstreetmap.org/search",
            params={"q": f"{kota}, Indonesia", "format": "json", "limit": 1},
            headers={"User-Agent": "qris-report/2.0"},
            timeout=15,
        )
        r.raise_for_status()
        data = r.json()
        if not data:
            return None
        d = data[0]
        return {
            "label": d.get("display_name"),
            "lat": d.get("lat"),
            "lon": d.get("lon"),
            "osm": f"https://www.openstreetmap.org/?mlat={d.get('lat')}&mlon={d.get('lon')}#map=12/{d.get('lat')}/{d.get('lon')}",
        }
    except requests.RequestException:
        return None


